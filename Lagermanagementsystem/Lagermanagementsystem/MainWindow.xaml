<Window x:Class="Lagermanagementsystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lagermanagementsystem"
        mc:Ignorable="d"
        Title="Lagermanagementsystem" Height="300" Width="300">
    <Window.Resources>
        <Style
            TargetType="Button"
            >
            <Setter
                Property="Margin"
                Value="0 2 0 5"
                />
        </Style>
    </Window.Resources>
    
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            >
            <TextBlock
                Text="Artikelname:"
                />
            <TextBox
                Name="txtArtikelName"
                />
            <TextBlock
                Text="Benötigte Stellplätze:"
                />
            <TextBox
                Name="txtStellplaetze"
                />
            <Button
                Name="BtnEinlagern"
                Content="Einlagern"
                Click="BtnEinlagern_Click"
                />

            <TextBlock
                Text="Regal:"
                />
            <TextBox
                Name="txtRegalIndex"
                />
            <TextBlock
                Text="Artikel Stellplatz:"
                />
            <TextBox
                Name="txtStellplaetzIndex"
                />
            <Button
                Name="BtnEntnehmen"
                Content="Entnehmen"
                Click="BtnEntnehmen_Click"
                />

            <Button
                Name="BtnAufraeumen"
                Content="Aufräumen"
                Click="BtnAufraeumen_Click"
                />

            <Button
                Name="BtnAnzeigen"
                Content="Eingelagerte Waren anzeigen"
                Click="BtnAnzeigen_Click"
                />
        </StackPanel>
        <TextBlock
            Name="txtOutput"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Margin="5"
            FontWeight="Bold"
            />
    </Grid>
</Window>
